# ==============================================================================
# Ansible Inventory Template (DevOps Bootcamp Capstone)
#
# All configurations are run from the Ansible Controller (10.0.0.135).
# Target hosts are defined by their internal VPC private IPs.
# ==============================================================================

[web]
web-server ansible_host=10.0.0.5

[monitoring]
monitoring-server ansible_host=10.0.0.136

[targets:children]
web
monitoring

[targets:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/devops-bootcamp-key
ansible_python_interpreter=/usr/bin/python3
