# ==============================================================================
# Prometheus Configuration (Managed via Ansible)
# Target: Scrapes local Prometheus server and Web EC2 node_exporter
# ==============================================================================

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node_exporter
    static_configs:
      - targets: ['{{ node_exporter_host | default(hostvars[groups["web"][0]]["private_ip"] | default(hostvars[groups["web"][0]]["ansible_host"] if (hostvars[groups["web"][0]]["ansible_host"] is defined and not (hostvars[groups["web"][0]]["ansible_host"] | string).startswith("i-")) else "10.0.0.5")) }}:{{ node_exporter_port }}']
